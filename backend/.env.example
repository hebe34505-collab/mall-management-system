# 复制本文件为 backend/.env 后再填写。不要把真实密码提交到 Git。
# 开发环境测试账号写在 database/seed.sql，生产环境禁止沿用默认密码。

SERVER_PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:3306/mall_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=请改成你的MySQL密码
JWT_SECRET=请改成至少32位的随机字符串
JWT_EXPIRATION_MINUTES=120
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
